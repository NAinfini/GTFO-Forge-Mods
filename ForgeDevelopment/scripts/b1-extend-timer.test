# V1 B1 mechanism hall, cell 加时终端 (official mechanism m-extend-timer: a 1200 s countdown from the start of the level, not failing the
# expedition; its terminal adds 60 s once with ADMIN_TEMP_OVERRIDE). Run on a freshly loaded B1 of the V1 package, as in
# b1-security-sensor.test.
#
# Room 机关样例区. Teleport points are room-local Unity metres: Unity (x, y, z) = editor (-x, y, z), the
# V1 builder's room frame with x mirrored (v1-test-kit cellSpot). The V1 build's terminals, Unity frame: 传感器终端 (7.678, -29),
# 加时终端 (-9.678, -8), 多选一终端 (9.678, -40). A teleport lands 1.2 m on the room's +z side of one; `interact name=Terminal` presses
# there when the game already selects the terminal, else walks to a stand in front of its screen.
# Level variables (var.g + sha256 of [package NAinfini-Forge_V1_Rundown, B1 expedition expedition:876af89dc8833731cdd9a1dbeea5, row id]):
#   加时终端 · countdown.remaining level.ve08436c46e8048a4bd8096c115d740be  var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf
#   加时倒计时归零                 level.v1.t_a126c15c147486d99153543e2372   var.g134b69713643b6c53aeba7e688af73f1fc472ca60b01d27ce71e96b6ad8a08b1
# Entering the terminal depends on the console interact fix of the devconsole-interact lane.
stop-on-fail
god on

# the countdown runs and shows on the HUD timer
teleport room=机关样例区 -9.678 0 -6.8
state hud as=hud_before
state variables var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf as=before
expect $before.matched == 1

# one extension: the remaining time jumps up
interact name=Terminal radius=4
terminal type "ADMIN_TEMP_OVERRIDE" as=first
wait 1s
state variables var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf as=extended
expect $extended.var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf > $before.var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf

# a second try adds nothing: the remaining time only goes down from here
terminal type "ADMIN_TEMP_OVERRIDE" as=second
wait 2s
state variables var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf as=again
expect $again.var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf < $extended.var.g52dca1f6a82bb4deae608a27897f895281870ac50747461149676728a674e8bf
terminal exit
state hud as=hud_after

# not expired
state variables var.g134b69713643b6c53aeba7e688af73f1fc472ca60b01d27ce71e96b6ad8a08b1 as=expired
expect $expired.matched == 0
expect log --all !contains "Exception"
