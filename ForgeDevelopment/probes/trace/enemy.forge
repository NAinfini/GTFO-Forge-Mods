{
  "profile": "enemy",
  "enabledByDefault": true,
  "entries": [
    {
      "type": "Enemies.EnemyAgent",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "LateUpdate",
        "get_*",
        "set_*",
        "_*",
        "ListenerDetectNoise"
      ],
      "record": "args+result",
      "instance": [
        "m_tagMarker",
        "Damage.Health",
        "m_alive",
        "EnemyDataID",
        "m_dimensionIndex",
        "EnemyData.persistentID"
      ],
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count"
    },
    {
      "type": "Enemies.EnemyAI",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "get_*",
        "set_*",
        "SetDetectedAgent",
        "SetTarget"
      ],
      "record": "args+result",
      "instance": [
        "m_mode",
        "m_behaviour.m_currentStateName",
        "Target"
      ],
      "firstStack": true,
      "maxPerSecond": 40,
      "onOverflow": "count"
    },
    {
      "type": "Enemies.EnemyBehaviour",
      "methods": [
        "UpdateState",
        "FixedUpdateState",
        "SignalEvent",
        "SetIncomingExtraStateData",
        "OnSetupStateMachine",
        "Setup",
        "SetAI"
      ],
      "record": "args+result",
      "instance": [
        "m_currentState"
      ],
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count"
    },
    {
      "type": "Enemies.EnemyBehaviour",
      "methods": [
        "ChangeState"
      ],
      "record": "args+result",
      "instance": [
        "m_currentStateName",
        "m_ai.m_enemyAgent.GlobalID",
        "m_ai.Target.m_detectionType",
        "m_ai.Target.m_agent.GlobalID"
      ],
      "firstStack": true,
      "maxPerSecond": 20,
      "onOverflow": "count",
      "phases": "before+after",
      "acoustic": {
        "layer": "wakeup-propagation",
        "source": {
          "from": "parent.source"
        },
        "receiver": {
          "actor": "instance.m_ai.m_enemyAgent",
          "role": "enemy"
        },
        "fields": {
          "state": "instance.m_currentStateName"
        }
      }
    },
    {
      "type": "ES_DeadBase",
      "methods": [
        "Enter",
        "Exit",
        "ActivateState",
        "ActivateStateWithData",
        "CommonEnter",
        "CommonExit",
        "OnAttackWindUp",
        "OnAttackPerform",
        "DoStartAttack",
        "DoWakeup",
        "DoHeartbeat",
        "Heartbeat",
        "StartBeat",
        "EndBeat",
        "DoStartDetection",
        "DoEndDetection",
        "MasterStartDetection",
        "MasterEndDetection",
        "DamageShouldTriggerHitreact",
        "OnHitreactDone",
        "Stop"
      ],
      "exclude": [
        "Update",
        "FixedUpdate",
        "MoveNext",
        "System_*",
        "__c*"
      ],
      "record": "args+result",
      "instance": [
        "m_enemyAgent"
      ],
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count"
    },
