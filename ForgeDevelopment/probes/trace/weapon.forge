{
  "profile": "weapon",
  "enabledByDefault": true,
  "entries": [
    {
      "type": "Gear.BulletWeapon",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "FixedUpdate",
        "get_*",
        "set_*",
        "Trigger*Audio*",
        "UpdateMagazineCartridgesVisible",
        "UpdateRTPCForDelay",
        "SetMagazineVisibile"
      ],
      "record": "args+result",
      "instance": [
        "m_clip",
        "m_burstMax",
        "m_burstCurrentCount",
        "IsCurrentlyBurstFiring",
        "m_lastFireTime",
        "ArchetypeData",
        "RecoilData",
        "m_archeType",
        "m_archeType.m_archetypeData",
        "m_archeType.m_recoilData"
      ],
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count"
    },
    {
      "type": "Gear.Shotgun",
      "methods": [
        "Fire",
        "OnGearSpawnComplete"
      ],
      "record": "args+result",
      "instance": [
        "m_clip",
        "ArchetypeData"
      ],
      "firstStack": true,
      "maxPerSecond": 40,
      "onOverflow": "count"
    },
    {
      "type": "Weapon",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "get_*",
        "set_*"
      ],
      "record": "args+result",
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count"
    },
    {
      "type": "ItemEquippable",
      "methods": [
        "Fire",
