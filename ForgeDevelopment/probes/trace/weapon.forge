    {
      "type": "MineDeployerInstance_Detonate_Explosive",
      "methods": ["Setup", "TriggerDetonate", "DoExplode"],
      "record": "args+result",
      "instance": [
        "m_core.Owner.PlayerSlotIndex",
        "m_delay", "m_radius", "m_distanceMin", "m_distanceMax",
        "m_damageMin", "m_damageMax", "m_explosionForce"
      ],
      "phases": "before+after",
      "firstStack": true,
      "maxPerSecond": 20,
      "onOverflow": "count"
    },
    {
      "type": "MineDeployerInstance_Detonate_Glue",
      "methods": ["Setup", "TriggerDetonate", "DoExplode", "ExplosionSequence"],
      "record": "args+result",
      "instance": [
