        "TryStartAnimationSequenceCoroutine",
        "TriggerFireAnimationSequence",
        "TriggerEquipAnimationSequence",
        "ReceiveClassItemSync",
        "SetOwner",
        "BatteryConsumption",
        "PickUp"
      ],
      "record": "args+result",
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count",
      "exclude": [
        "OnSyncFire"
      ]
    },
    {
      "type": "Gear.MeleeWeaponFirstPerson",
