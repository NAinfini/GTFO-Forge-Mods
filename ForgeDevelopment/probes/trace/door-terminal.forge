{
  "profile": "door-terminal",
  "enabledByDefault": true,
  "entries": [
    {
      "type": "LevelGeneration.LG_SecurityDoor",
      "methods": [
        "*"
      ],
      "exclude": [
        "get_*",
        "set_*",
        "_Setup*",
        "Setup"
      ],
      "record": "args+result",
      "instance": [
        "m_lastState",
        "Gate.m_linksTo",
        "m_checkpointPuzzle.Data.TriggerAlarmOnActivate",
        "Gate.HasBeenOpenedDuringPlay",
        "m_securityDoorType",
        "Gate.ForceSecurityGate",
        "Gate.ForceApexGate",
        "Gate.ForceBulkheadGate",
        "Gate.ForceBulkheadGateMainPath"
      ],
      "firstStack": true,
      "maxPerSecond": 50,
      "onOverflow": "count"
    },
    {
