        "set_*"
      ],
      "record": "args+result",
      "firstStack": true,
      "maxPerSecond": 40,
      "onOverflow": "count"
    },
    {
      "type": "GameEvent.GameEventManager",
      "methods": [
        "PostEvent"
      ],
      "record": "args",
      "firstStack": true,
      "maxPerSecond": 30,
      "onOverflow": "count"
    },
    {
      "type": "PLOC_GrabbedByTank",
      "methods": [
        "IncomingTankTentacleGrab"
      ],
      "firstStack": true,
      "maxPerSecond": 20,
      "onOverflow": "count",
      "record": "args+result",
      "instance": [
        "m_owner.PlayerSlotIndex",
        "m_owner.Damage.GrabbedByTank",
        "m_inState"
      ],
      "phases": "before+after"
    },
    {
      "type": "PlayerVoice",
      "methods": [
        "SayLine"
      ],
      "firstStack": true,
      "maxPerSecond": 20,
      "onOverflow": "count",
      "record": "args+result",
      "instance": [
        "m_owner.PlayerSlotIndex",
        "m_playerID",
        "m_currentDialogID"
      ],
      "phases": "before+after"
    },
    {
      "type": "PlayerInventoryBase",
      "record": "args+result",
      "firstStack": true,
      "maxPerSecond": 20,
      "onOverflow": "count",
      "methods": [
        "ReceiveSimpleItemStatus"
      ],
      "instance": [
        "Owner.PlayerSlotIndex",
        "Owner.Noise",
        "lastSentStatus",
        "WieldedSlot"
      ],
      "phases": "before+after",
      "acoustic": {
        "layer": "player-detection",
        "source": {
          "actor": "instance.Owner",
          "role": "player"
        },
        "fields": {
          "noise": "instance.Owner.Noise",
          "playerSlot": "instance.Owner.PlayerSlotIndex"
        }
      }
    },
    {
      "type": "PlayerInventoryBase",
      "record": "args+result",
      "firstStack": true,
      "maxPerSecond": 20,
      "onOverflow": "count",
      "methods": [
        "SendSimpleItemStatus"
      ],
      "instance": [
        "Owner.PlayerSlotIndex",
        "Owner.Noise",
        "lastSentStatus",
        "WieldedSlot"
      ],
      "phases": "before+after",
      "acoustic": {
        "layer": "player-detection",
        "source": {
          "actor": "instance.Owner",
          "role": "player"
        },
        "fields": {
          "noise": "instance.Owner.Noise",
          "playerSlot": "instance.Owner.PlayerSlotIndex"
