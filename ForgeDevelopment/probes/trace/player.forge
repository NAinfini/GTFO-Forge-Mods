{
  "profile": "player",
  "enabledByDefault": true,
  "entries": [
    {
      "type": "Player.PlayerAgent",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "LateUpdate",
        "get_*",
        "set_*",
        "Gear_iResourcePackReceiver_*",
        "_*",
        "RequestWarpToSync",
        "TeleportTo",
        "TryWarpTo",
        "WarpBack",
        "WarpTo"
      ],
      "record": "args+result",
      "instance": [
        "Damage.Health",
        "m_alive",
        "Locomotion.Downed",
        "Damage.Infection",
        "PlayerSlotIndex"
      ],
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count"
    },
    {
      "type": "Player.PlayerAgent",
      "methods": [
        "set_Alive"
      ],
      "record": "args",
      "instance": [
        "m_alive",
        "PlayerSlotIndex"
      ],
      "firstStack": true,
      "maxPerSecond": 20,
      "onOverflow": "count"
    },
    {
      "type": "Player.LocalPlayerAgent",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "LateUpdate",
        "get_*",
        "set_*"
      ],
      "record": "args+result",
      "firstStack": true,
      "maxPerSecond": 40,
      "onOverflow": "count"
    },
    {
      "type": "Dam_PlayerDamageBase",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "get_*",
        "set_*",
        "ModifyInfection",
        "ReceiveAddHealth",
        "ReceiveFallDamage",
        "ReceiveNoAirDamage",
        "ReceiveParasiteDamage",
        "ReceiveParasiteTrapDamage",
        "ReceivePushDamage",
        "ReceiveSetHealth",
        "ReceiveShooterProjectileDamage",
        "ReceiveStickyDamage",
        "ReceiveTentacleAttackDamage",
        "ReceiveTentacleGrabStop",
        "ReceiveTentacleTankGrabDamage",
        "ReceiveTentacleTrapGrabDamage",
        "ReceiveBulletDamage",
        "ReceiveMeleeDamage",
        "OnIncomingDamage"
      ],
      "record": "args+result",
      "instance": [
        "Owner",
        "Owner.PlayerSlotIndex",
        "Health",
        "HealthMax",
        "DamageMax"
      ],
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count"
    },
    {
      "type": "Dam_PlayerDamageBase",
      "methods": [
        "OnIncomingDamage"
      ],
      "record": "args+result",
      "instance": [
        "Owner.GlobalID",
        "Owner.PlayerSlotIndex",
        "Health",
        "HealthMax"
      ],
      "firstStack": true,
      "maxPerSecond": 60,
      "onOverflow": "count",
      "phases": "before+after"
    },
    {
      "type": "Dam_PlayerDamageBase",
      "methods": [
        "ReceiveMeleeDamage"
      ],
      "record": "args+result",
      "instance": [
        "Owner.GlobalID",
