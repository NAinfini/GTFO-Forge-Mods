{
  "profile": "level",
  "enabledByDefault": true,
  "entries": [
    {
      "type": "GameStateManager",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "FixedUpdate",
        "get_*",
        "set_*",
        "add_*",
        "remove_*",
        "ChangeState",
        "DoChangeState"
      ],
      "record": "args+result",
      "instance": [
        "CurrentState",
        "CurrentStateName"
      ],
      "firstStack": true,
      "maxPerSecond": 25,
      "onOverflow": "count"
    },
    {
      "type": "RundownManager",
      "methods": [
        "*"
      ],
      "exclude": [
        "MasterSelectActiveExpedition",
        "MainLayerCompleted",
        "Update",
        "get_*",
        "set_*",
        "Awake"
      ],
      "record": "args+result",
      "instance": [
        "m_activeExpedition",
        "ActiveExpedition",
        "m_parsedRundownDatas"
      ],
      "firstStack": true,
      "maxPerSecond": 25,
      "onOverflow": "count"
    },
    {
      "type": "WardenObjectiveManager",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "UpdateFromInLevel",
        "get_*",
        "set_*",
        "add_*",
        "remove_*"
      ],
      "record": "args+result",
      "instance": [
        "m_stateReplicator.State.extraTime"
      ],
      "firstStack": true,
      "maxPerSecond": 40,
      "onOverflow": "count"
    },
    {
      "type": "WorldEventManager",
      "methods": [
        "*"
      ],
      "exclude": [
        "Update",
        "get_*",
        "set_*",
        "DoExcecuteEvent",
        "ExecuteEvent",
        "ExecuteEvent_Internal"
      ],
      "record": "args+result",
      "instance": [
        "m_stateReplicator.State",
        "m_stateReplicator"
      ],
      "firstStack": true,
      "maxPerSecond": 40,
      "onOverflow": "count"
    },
    {
      "type": "GameData.WardenObjectiveEventData",
      "methods": [
        "ToString"
      ],
      "record": "args+result",
      "maxPerSecond": 40,
      "onOverflow": "count"
    },
