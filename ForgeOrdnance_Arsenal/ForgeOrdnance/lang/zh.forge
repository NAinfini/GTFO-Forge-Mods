{
  "arsenal.strike.precision.Name": "精确打击",
  "arsenal.strike.precision.Description": "一发重炮弹砸在信标上。范围小，伤害高，会误伤队友。",
  "arsenal.strike.area.Name": "区域轰炸",
  "arsenal.strike.area.Description": "几秒内七发炮弹落在信标周围约 15 米内。",
  "arsenal.strike.creeping.Name": "徐进弹幕",
  "arsenal.strike.creeping.Description": "一排排炮弹从信标沿投掷方向往前推进。",
  "arsenal.strike.cluster.Name": "集束轰炸",
  "arsenal.strike.cluster.Description": "大量小炸弹沿一条线在信标上炸开。",
  "arsenal.strike.incendiary.Name": "燃烧轰炸",
  "arsenal.strike.incendiary.Description": "点燃落点一片区域，待在里面会持续掉血。",
  "arsenal.strike.gas.Name": "毒气轰炸",
  "arsenal.strike.gas.Description": "投下一罐毒气，毒云持续造成伤害，队友也会中毒。",
  "arsenal.strike.stasis.Name": "静滞打击",
  "arsenal.strike.stasis.Description": "静滞装置让 8 米内的敌人减速 20 秒，离开力场后恢复。",
  "arsenal.strike.beam.Name": "切割光束",
  "arsenal.strike.beam.Description": "一道光束从天而降，约 10 秒内追着附近的敌人烧。",
  "arsenal.strike.strafe.Name": "扫射",
  "arsenal.strike.strafe.Description": "从信标沿投掷方向扫过一条直线。只有曳光弹，没有爆炸，只打到条带内的敌人。",
  "arsenal.strike.hunter.Name": "猎杀打击",
  "arsenal.strike.hunter.Description": "激光锁定信标所在房间里最大的敌人，随后一发炮弹高速砸下，击杀或重创。",
  "arsenal.weapon.machinegun.Name": "重机枪",
  "arsenal.weapon.machinegun.Description": "空投舱送来的大弹匣机枪。替换你的特殊武器，直到打空或丢掉。",
  "arsenal.weapon.antimateriel.Name": "反器材步枪",
  "arsenal.weapon.antimateriel.Description": "高伤害、高穿透的重型单发步枪。暂时替换你的特殊武器。",
  "arsenal.weapon.grenadelauncher.Name": "榴弹发射器",
  "arsenal.weapon.grenadelauncher.Description": "发射爆炸榴弹。暂时替换你的特殊武器。",
  "arsenal.weapon.recoilless.Name": "无后坐力炮",
  "arsenal.weapon.recoilless.Description": "单发火箭筒。爆炸直接伤害敌人本体，不受护甲影响，边缘衰减到一半。暂时替换你的特殊武器。",
  "arsenal.weapon.tracking.Name": "追踪步枪",
  "arsenal.weapon.tracking.Description": "曳光会拐向准星附近敌人并命中的自动步枪。替换你的特殊武器，直到打空或丢掉。",
  "arsenal.supply.mixed.Name": "混合补给舱",
  "arsenal.supply.mixed.Description": "空投舱送来 2 个弹药包、1 个医疗包和 1 个工具补给包。",
  "arsenal.supply.ammo.Name": "弹药补给舱",
  "arsenal.supply.ammo.Description": "空投舱送来 3 个弹药包。",
  "arsenal.supply.medical.Name": "医疗补给舱",
  "arsenal.supply.medical.Description": "空投舱送来 2 个医疗包和 1 个消毒包。",
  "arsenal.supply.tool.Name": "工具补给舱",
  "arsenal.supply.tool.Description": "空投舱送来 2 个工具补给包。",
  "arsenal.supply.consumables.Name": "消耗品补给舱",
  "arsenal.supply.consumables.Description": "空投舱送来 2 颗泡沫手雷。",
  "arsenal.deploy.foam.Name": "胶泡布撒器",
  "arsenal.deploy.foam.Description": "落地升起并旋转，向四周抛出泡沫雷，共两轮。敌人靠近时雷向四周喷出 C-foam，粘住并拖慢敌人。雷留在原地 120 秒。",
  "arsenal.deploy.mines.Name": "布雷器",
  "arsenal.deploy.mines.Description": "落地升起并旋转，向四周抛出地雷，共两轮。敌人靠近就爆炸，会误伤队友。雷留在原地 120 秒。",
  "arsenal.deploy.scanner.Name": "侦测塔",
  "arsenal.deploy.scanner.Description": "落地升起，把 35 米内醒着的敌人标记给全队（不标睡眠中的）。150 秒后收回。",
  "arsenal.deploy.floodlight.Name": "照明塔",
  "arsenal.deploy.floodlight.Description": "落地升起，照亮一大片区域并驱散雾。150 秒后收回。",
  "arsenal.supply.syringe.Name": "注射器补给舱",
  "arsenal.supply.syringe.Description": "空投舱送来 2 支治疗注射器和 2 支近战注射器。",
  "arsenal.supply.mines.Name": "地雷补给舱",
  "arsenal.supply.mines.Description": "空投舱送来 2 枚爆炸绊雷和 2 枚泡沫绊雷。",
  "arsenal.supply.utility.Name": "杂项补给舱",
  "arsenal.supply.utility.Description": "空投舱送来 1 个驱雾器、1 个熔锁器和 2 颗泡沫手雷。",
  "arsenal.turret.watch.Name": "守望哨戒炮",
  "arsenal.turret.watch.Description": "从天而降的点射哨戒炮，各方面均衡。弹药打光或 180 秒后收回地下。",
  "arsenal.turret.bulwark.Name": "壁垒哨戒炮",
  "arsenal.turret.bulwark.Description": "从天而降的狙击哨戒炮，射程远、伤害高，专打大怪。弹药打光或 180 秒后收回地下。",
  "arsenal.turret.scythe.Name": "镰刀哨戒炮",
  "arsenal.turret.scythe.Description": "从天而降的霰弹哨戒炮，近距离清怪群。弹药打光或 180 秒后收回地下。"
}
