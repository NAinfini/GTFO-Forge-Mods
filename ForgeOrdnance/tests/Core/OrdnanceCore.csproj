<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The linked ForgeCore sources hold internal structs whose fields only the library's game-side code fills. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <RootNamespace>ForgeOrdnance.Tests</RootNamespace>
    <AssemblyName>ForgeOrdnance.Core.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The three parts' Core sources are compiled straight into the test: they reference no game or Unity assembly. -->
    <Compile Include="../../Carrier/Core/*.cs" Link="Carrier/%(Filename)%(Extension)" />
    <Compile Include="../../Arsenal/Core/*.cs" Link="Arsenal/%(Filename)%(Extension)" />
    <Compile Include="../../Frames/Core/*.cs" Link="Frames/%(Filename)%(Extension)" />
    <!-- What they use of ForgeCore: the strict readers, the log, the shared special slot the heavy weapons and the suit gun lease, the slow-frame timers, the enemy alert states and the struct message bodies. -->
    <Compile Include="../../../ForgeCore/Net/NetWire.cs;../../../ForgeCore/Once/Fnv.cs;../../../ForgeCore/Once/StrictJson.cs;../../../ForgeCore/Once/PackItem.cs;../../../ForgeCore/Once/OnceReporter.cs;../../../ForgeCore/Core/Log.cs;../../../ForgeCore/Core/SpecialSlot.cs;../../../ForgeCore/Core/FrameBook.cs;../../../ForgeCore/Core/EnemyAlert.cs" Link="ForgeCore/%(Filename)%(Extension)" />
    <!-- ForgeUI Core the cockpit drives (no Unity types): the progress bar, the reveal, the power-on timeline and message. -->
    <Compile Include="../../../ForgeCore/UI/Core/ProgressBar.cs;../../../ForgeCore/UI/Core/HudReveal.cs;../../../ForgeCore/UI/Core/Easing.cs;../../../ForgeCore/UI/Core/PowerOnTimeline.cs;../../../ForgeCore/UI/Core/BootMessage.cs;../../../ForgeCore/UI/Core/HudLayout.cs;../../../ForgeCore/UI/Core/GaugeMath.cs;../../../ForgeCore/UI/Core/Meter.cs;../../../ForgeCore/UI/Core/Bearing.cs;../../../ForgeCore/UI/Core/ScopeSwitches.cs" Link="UIKit/%(Filename)%(Extension)" />
    <!-- ForgeVisual's body bones and pose rules the suits' rig maps onto (Core, no game or Unity assembly). -->
    <Compile Include="../../../ForgeCore/Visual/Core/BodyRig.cs" Link="ForgeVisual/%(Filename)%(Extension)" />
    <Compile Include="Program.cs;CarrierChecks.cs;ArsenalChecks.cs;FramesChecks.cs" />
  </ItemGroup>
</Project>
