{
  "arsenal.strike.precision.Name": "Precision Strike",
  "arsenal.strike.precision.Description": "One heavy shell on the beacon. Small radius, high damage. Hurts teammates.",
  "arsenal.strike.area.Name": "Area Strike",
  "arsenal.strike.area.Description": "Seven shells land within about 15 m of the beacon over a few seconds.",
  "arsenal.strike.creeping.Name": "Creeping Barrage",
  "arsenal.strike.creeping.Description": "Rows of shells walk forward from the beacon in the throw direction.",
  "arsenal.strike.cluster.Name": "Cluster Strike",
  "arsenal.strike.cluster.Description": "Many small bombs burst in a line across the beacon.",
  "arsenal.strike.incendiary.Name": "Incendiary Strike",
  "arsenal.strike.incendiary.Description": "Sets the impact zone on fire. Anyone inside keeps taking damage.",
  "arsenal.strike.gas.Name": "Gas Strike",
  "arsenal.strike.gas.Description": "A canister releases a toxic cloud that deals damage over time. Poisons teammates too.",
  "arsenal.strike.stasis.Name": "Stasis Strike",
  "arsenal.strike.stasis.Description": "A stasis device slows enemies within 8 m for 20 s. They recover once they leave the field.",
  "arsenal.strike.beam.Name": "Cutting Beam",
  "arsenal.strike.beam.Description": "A beam drops from above and chases nearby enemies for about 10 s.",
  "arsenal.strike.strafe.Name": "Strafing Run",
  "arsenal.strike.strafe.Description": "A gun run from the beacon along the throw direction. Tracers, no explosions: only enemies in the strip are hit.",
  "arsenal.strike.hunter.Name": "Hunter Strike",
  "arsenal.strike.hunter.Description": "A laser locks the biggest enemy in the beacon's room, then one fast shell. Kills or badly wounds it.",
  "arsenal.weapon.machinegun.Name": "Heavy Machine Gun",
  "arsenal.weapon.machinegun.Description": "A big-magazine machine gun from the drop pod. Replaces your special weapon until it runs dry or is dropped.",
  "arsenal.weapon.antimateriel.Name": "Anti-Materiel Rifle",
  "arsenal.weapon.antimateriel.Description": "A heavy single-shot rifle with high damage and penetration. Replaces your special weapon for a while.",
  "arsenal.weapon.grenadelauncher.Name": "Grenade Launcher",
  "arsenal.weapon.grenadelauncher.Description": "Fires explosive grenades. Replaces your special weapon for a while.",
  "arsenal.weapon.recoilless.Name": "Recoilless Rifle",
  "arsenal.weapon.recoilless.Description": "A single-shot rocket launcher. Its blast hurts enemies directly, armour or not, and fades to half at the edge. Replaces your special weapon for a while.",
  "arsenal.weapon.tracking.Name": "Tracking Rifle",
  "arsenal.weapon.tracking.Description": "An automatic rifle whose tracers bend toward enemies near your crosshair and hit them. Replaces your special weapon until it runs dry or is dropped.",
  "arsenal.supply.mixed.Name": "Mixed Supply Pod",
  "arsenal.supply.mixed.Description": "The drop pod delivers 2 Ammo Packs, 1 Medi Pack and 1 Tool Refill Pack.",
  "arsenal.supply.ammo.Name": "Ammo Pod",
  "arsenal.supply.ammo.Description": "The drop pod delivers 3 Ammo Packs.",
  "arsenal.supply.medical.Name": "Medical Pod",
  "arsenal.supply.medical.Description": "The drop pod delivers 2 Medi Packs and 1 Disinfect Pack.",
  "arsenal.supply.tool.Name": "Tool Pod",
  "arsenal.supply.tool.Description": "The drop pod delivers 2 Tool Refill Packs.",
  "arsenal.supply.consumables.Name": "Consumables Pod",
  "arsenal.supply.consumables.Description": "The drop pod delivers 2 C-Foam Grenades.",
  "arsenal.deploy.foam.Name": "Foam Sprayer",
  "arsenal.deploy.foam.Description": "Drops, rises and spins, throwing foam mines all around, twice. A mine sprays C-Foam in every direction when an enemy comes close. Sticks and slows enemies. Mines last 120 s.",
  "arsenal.deploy.mines.Name": "Mine Layer",
  "arsenal.deploy.mines.Description": "Drops, rises and spins, throwing mines all around, twice. A mine bursts when an enemy comes close. Hurts teammates. Mines last 120 s.",
  "arsenal.deploy.scanner.Name": "Scanner Tower",
  "arsenal.deploy.scanner.Description": "Drops and rises. Tags every awake enemy within 35 m for the whole team (not sleepers). Recalled after 150 s.",
  "arsenal.deploy.floodlight.Name": "Floodlight Tower",
  "arsenal.deploy.floodlight.Description": "Drops and rises. Lights a wide area and pushes the fog back. Recalled after 150 s.",
  "arsenal.supply.syringe.Name": "Syringe Pod",
  "arsenal.supply.syringe.Description": "The drop pod delivers 2 Health Syringes and 2 Melee Syringes.",
  "arsenal.supply.mines.Name": "Mine Pod",
  "arsenal.supply.mines.Description": "The drop pod delivers 2 Explosive Trip Mines and 2 C-Foam Trip Mines.",
  "arsenal.supply.utility.Name": "Utility Pod",
  "arsenal.supply.utility.Description": "The drop pod delivers 1 Fog Repeller, 1 Lock Melter and 2 C-Foam Grenades.",
  "arsenal.turret.watch.Name": "Watch Turret",
  "arsenal.turret.watch.Description": "A burst-fire sentry dropped from above. Balanced. Sinks back underground when out of ammo or after 180 s.",
  "arsenal.turret.bulwark.Name": "Bulwark Turret",
  "arsenal.turret.bulwark.Description": "A sniper sentry dropped from above. Long range, high damage, built for big enemies. Sinks back underground when out of ammo or after 180 s.",
  "arsenal.turret.scythe.Name": "Scythe Turret",
  "arsenal.turret.scythe.Description": "A shotgun sentry dropped from above. Clears swarms up close. Sinks back underground when out of ammo or after 180 s."
}
