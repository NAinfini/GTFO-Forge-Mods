{
  "name": "forgeskin",
  "productName": "ForgeSkin",
  "version": "1.1.0",
  "description": "GTFO 武器皮肤工坊",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "node scripts/gen-types.mjs && electron-forge start",
