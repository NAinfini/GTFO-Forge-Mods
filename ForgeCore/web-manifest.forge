                },
                {
                  "module": "GameHooks.ThrowableThrown",
                  "type": "ThrowingWeapon",
                  "method": "Throw"
                },
                {
                  "module": "GameHooks.ProgressionObjectiveSet",
                  "type": "PUI_GameObjectives",
                  "method": "SetProgressionObjective"
                },
                {
                  "module": "GameHooks.ProgressionObjectiveRemoved",
                  "type": "PUI_GameObjectives",
                  "method": "RemoveProgressionObjective"
                },
                {
                  "module": "GameHooks.ObjectivesCleaned",
                  "type": "PUI_GameObjectives",
                  "method": "OnLevelCleanup"
                },
                {
                  "module": "GameHooks.SubObjectiveShown",
                  "type": "PUI_WardenIntel",
                  "method": "ShowSubObjectiveMessage"
                },
                {
                  "module": "GameHooks.PrioritySubObjectiveShown",
                  "type": "PUI_WardenIntel",
                  "method": "ShowPrioritySubObjectiveMessage"
                },
                {
                  "module": "GameHooks.ExpeditionWindowVisible",
                  "type": "CellMenu.CM_ExpeditionWindow",
                  "method": "SetVisible"
                },
                {
                  "module": "GameHooks.MasterMigrationFound",
                  "type": "SNetwork.SNet_SyncManager",
                  "method": "OnFoundNewMasterDuringMigration"
                },
                {
                  "module": "GameHooks.MasterFound",
                  "type": "SNetwork.SNet_SyncManager",
                  "method": "OnFoundMaster"
                },
                {
                  "module": "GameHooks.GameEventPosted",
                  "type": "GameEvent.GameEventManager",
                  "method": "PostEvent"
                },
                {
                  "module": "GameHooks.PlayerReplicationSpawned",
                  "type": "Player.PlayerReplicationManager",
                  "method": "OnSpawn"
                },
                {
                  "module": "GameHooks.PlayerReplicationDespawned",
                  "type": "Player.PlayerReplicationManager",
                  "method": "OnDeSpawn"
                },
                {
                  "module": "GameHooks.PlayerManagerSpawned",
                  "type": "Player.PlayerManager",
                  "method": "OnPlayerSpawned"
                },
                {
                  "module": "GameHooks.GameLogAdded",
                  "type": "PUI_GameEventLog",
                  "method": "AddLogItem"
                }
              ]
            },
            {
              "id": "Puppets",
              "summary": "Holds an enemy or a non-local player agent as a puppet: its own control is switched off and the caller drives place, animation, states and actions through the game's own entries (an enemy's sleep, heartbeat, light sleep and exact wake-up animation among them); an enemy puppet's own projectile and tentacle launches are held off; a take-back by the game is put right and counted.",
              "patches": [
                {
                  "module": "Puppets.MovementHold",
                  "type": "Player.PlayerLocomotion",
                  "method": "UpdateMovementFromSync"
                },
                {
                  "module": "Puppets.AttackHold",
                  "type": "EAB_ProjectileShooter",
                  "method": "FireBurst"
                },
                {
                  "module": "Puppets.AttackHold",
                  "type": "EAB_MovingEnemeyTentacle",
                  "method": "Attack"
                },
                {
                  "module": "Puppets.AttackHold",
                  "type": "EAB_MovingEnemyTentacleMultiple",
                  "method": "Attack"
                }
              ]
            },
            {
              "id": "Fnv",
              "summary": "FNV-1a 32 and 64 bit over UTF-8 text or bytes, the one hash behind wire formats and saved keys."
            },
            {
              "id": "DeterministicRandom",
              "summary": "Random numbers that are a pure function of their keys (SplitMix64): every peer and a replay draw the same value, and the game's own random sequence is untouched."
            },
            {
              "id": "Hash",
              "summary": "SHA-256 as lowercase hex over bytes, UTF-8 text or a stream, the one spelling of a content hash."
            }
          ]
        }
      ]
    },
    {
      "id": "ui",
      "title": "UI",
      "namespace": "ForgeUI",
      "groups": [
        {
          "id": "regions",
          "title": "HUD regions",
          "entries": [
            {
              "id": "WeaponList",
              "summary": "Under the game's weapon list, right-aligned, stacking downwards.",
              "details": {
                "flowX": -1,
                "flowY": -1
              }
            },
            {
              "id": "Vitals",
              "summary": "Above the game's health bar and vitals, centred on the bar, stacking upwards.",
              "details": {
                "flowX": 0,
                "flowY": 1
              }
            },
            {
              "id": "CenterBanner",
              "summary": "A little above the middle of the screen: one element at a time (the highest priority one that is shown).",
              "details": {
                "flowX": 0,
                "flowY": 0
              }
            },
            {
              "id": "TopCenter",
              "summary": "The top edge of the screen, centred, stacking downwards.",
              "details": {
                "flowX": 0,
                "flowY": -1
              }
            },
            {
              "id": "Notices",
              "summary": "The top left corner under the game's own objective text, stacking downwards.",
              "details": {
                "flowX": 1,
                "flowY": -1
              }
            },
            {
              "id": "RightColumn",
              "summary": "The right edge in the middle of the screen, right-aligned, stacking downwards.",
              "details": {
                "flowX": -1,
                "flowY": -1
              }
            },
            {
              "id": "BottomLeft",
              "summary": "The bottom left corner, stacking upwards.",
              "details": {
                "flowX": 1,
                "flowY": 1
              }
            },
            {
              "id": "BottomRight",
              "summary": "The bottom right corner, right-aligned, stacking upwards.",
              "details": {
                "flowX": -1,
                "flowY": 1
              }
            },
            {
              "id": "World",
              "summary": "Free: the element's root is the middle of the screen and it follows places in the world (markers, hit ticks, damage numbers). It takes no room and is not laid out.",
              "details": {
                "flowX": 0,
                "flowY": 0
              }
            },
            {
              "id": "TopRight",
              "summary": "The top right corner, right-aligned, stacking downwards.",
              "details": {
                "flowX": -1,
                "flowY": -1
              }
            },
            {
              "id": "TopLeft",
              "summary": "The top left corner, stacking downwards (above Notices, which leaves room for the game's own objective text).",
              "details": {
                "flowX": 1,
                "flowY": -1
              }
            }
          ]
        },
        {
          "id": "registrations",
          "title": "Registrations",
          "entries": [
            {
              "id": "AddCrosshairAttachment(string)",
              "summary": "Marks drawn on the game's crosshair layer: a thin ring, ticks, an optional dot and a landing circle (see CrosshairAttachment). Null (logged) when the name cannot be used or is taken.",
              "name": "AddCrosshairAttachment",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "CrosshairAttachment"
              }
            },
            {
              "id": "AddEnemyHealthBars(string, EnemyHealthBarStyle?)",
              "summary": "Adds a switch for enemy health bars: while it is Active, an enemy the local player hits gets a thin bar over its head showing the health the game holds for it (on every machine the game applies every player's hits, so a teammate's damage shows too). The piece each hit takes flashes and then shrinks away. Bars show only for enemies in sight (a wall between hides the bar), fade a few seconds after the last hit and go at once when the enemy dies. Damage numbers and kill marks are the hit feedback's (AddHitFeedback). The player can turn every bar off in ForgeUI's config (EnemyHealthBars / Enabled).",
              "name": "AddEnemyHealthBars",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "style",
                  "type": "EnemyHealthBarStyle?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "EnemyHealthBar"
              }
            },
            {
              "id": "AddInteractPrompt(string)",
              "summary": "A claim on the game's interaction prompt (the line near the middle of the screen with a key in brackets). Call Show every frame the prompt should be up (the game's own prompts replace it between frames) and Hide when it should go. Null (logged) when the name cannot be used or is taken.",
              "name": "AddInteractPrompt",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "InteractPrompt"
              }
            },
            {
              "id": "AddCountdownMarker(Vector3, UIText, float, Color)",
              "summary": "One of the game's world markers that counts down to arriveAt (ForgeCore.Frame.GameTime) at position: name small and pale, then the seconds left in large digits (one decimal) in accent and, over the last three seconds, red and larger. Call Update every frame: it keeps the marker beside the position and changes the text only when a tenth of a second passes. Null (logged) when the game's marker layer refuses the marker.",
              "name": "AddCountdownMarker",
              "parameters": [
                {
                  "name": "position",
                  "type": "Vector3",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "name",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "arriveAt",
                  "type": "float",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "accent",
                  "type": "Color",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "NavMarkerHandle"
              }
            },
            {
              "id": "AddHitFeedback(string, HitFeedbackStyle?)",
              "summary": "Adds a switch for hit feedback: while it is Active, damage numbers float up from where hits land (hits on one target close together add up into one number), a marker flashes round the crosshair on a hit (stronger for a weak spot, larger and red for a kill), a kill leaves a short mark where the target was and a small confirmation beside the crosshair. With LocalHits the local player's hits on enemies drive it on their own; Pulse, Show and ShowAt drive it from your own code. The player can turn all hit feedback off in ForgeUI's config (HitFeedback / Enabled).",
              "name": "AddHitFeedback",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "style",
                  "type": "HitFeedbackStyle?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HitFeedback"
              }
            },
            {
              "id": "AddKeyAction(string, string, string, string, KeyMode, string, KeyModes)",
              "summary": "Registers a key action the player can rebind in the game's settings (Controls, under your group's heading). Read it every frame through the handle. Keys the player never changed follow defaultKey, also when you change the default in a later version; the same goes for the trigger mode, which the player picks from allowed in the same settings row group, together with the action's long-press and double-press times. Two actions whose same press would both fire (same key, overlapping contexts, any modes but a Tap with a Hold of at least its time, or a Tap with a Double), or an action on a key the game itself uses, are shown in the settings and logged; ForgeUI never moves anyone's key. A Tap, Hold or Double action alone on a game button's key hands every press that is not its own to that button (KeyMode; a Double action hands back the first press, the second is its own), so it shares the key without a conflict, unless the player sets it to fire together with the game (the settings' same-key row). All key reading and press timing lives here: a mod only reads the handle. Use the game's own bindings (InputAction) for what the game already has a key for, rather than a second action.",
              "name": "AddKeyAction",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "nameKey",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "groupKey",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "defaultKey",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "mode",
                  "type": "KeyMode",
                  "summary": "",
                  "default": "KeyMode.Press"
                },
                {
                  "name": "context",
                  "type": "string",
                  "summary": "",
                  "default": "\"\""
                },
                {
                  "name": "allowed",
                  "type": "KeyModes",
                  "summary": "",
                  "default": "KeyModes.All"
                }
              ],
              "details": {
                "returns": "KeyAction"
              }
            },
            {
              "id": "AddLobbyStrip(string, Func<SNet_Player, IReadOnlyList<LobbyStripItem>?>, int)",
              "summary": "A row of slot cells on every lobby bar with a player (the local one and everyone else's), one button step under the APPAREL button and the lobby buttons and exactly as wide as they are: each cell a chamfered tile in one muted dark tone with a light outline and a light band along its cut corner, the picture in its own colours. items gives each player's cells in slot order (null or empty shows no row); pass Empty for a free slot. Called once per bar per frame; it may return the same list it keeps, and the row is redrawn only when that content changes. Null (logged) when the name cannot be used or is taken.",
              "name": "AddLobbyStrip",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "items",
                  "type": "Func<SNet_Player, IReadOnlyList<LobbyStripItem>?>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "maxItems",
                  "type": "int",
                  "summary": "",
                  "default": 6
                }
              ],
              "details": {
                "returns": "LobbyStrip"
              }
            },
            {
              "id": "AddPowerOn(string, PowerOnSpec)",
              "summary": "A screen power-on and power-down played over the whole picture (see ScreenPowerOn): your panels and seams cut the screen, each panel comes on in its block's turn of Timeline with ForgeUI's glitch (the picture in your tint, banding, scanlines, split into your three channel colours with torn bands and noise bars in them) settling to the plain picture, and the seams fade once every block has settled; powering down runs the blocks in reverse to black and clears. An exclusive layer at Priority. Built and compiled by WarmNextLayer (or Warm). Null (logged) when the name is taken or the panels do not match the timeline.",
              "name": "AddPowerOn",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "spec",
                  "type": "PowerOnSpec",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "ScreenPowerOn"
              }
            },
            {
              "id": "AddHitEdge(string)",
              "summary": "Hit-direction flashes on the screen edge (an overlay layer, see HitEdge). Null (logged) when the name is taken.",
              "name": "AddHitEdge",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HitEdge"
              }
            },
            {
              "id": "AddVisor(string)",
              "summary": "A helmet visor over the screen (an overlay layer, see Visor). Null (logged) when the name is taken.",
              "name": "AddVisor",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "Visor"
              }
            },
            {
              "id": "AddTeammateTag(string, Func<SNet_Player, TeammateTag>, TeammateTagPlace)",
              "summary": "Adds a tag to every teammate row of every teammates panel (HudTeammates, whichever mod made it): per player, a status picture and a short value at the row's right before the health, and a hairline share under the health. read runs once per row per frame while a panel is drawn; return None for a player the tag does not apply to, and the same string while the value is the same. A callback that throws is turned off (logged once).",
              "name": "AddTeammateTag",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "read",
                  "type": "Func<SNet_Player, TeammateTag>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "place",
                  "type": "TeammateTagPlace",
                  "summary": "",
                  "default": "TeammateTagPlace.Row"
                }
              ],
              "details": {
                "returns": "TeammateTagSource"
              }
            },
            {
              "id": "AddLoadout(string, HudSlot?)",
              "summary": "The game's whole inventory in the cockpit style (see HudLoadout). Default slot: bottom right, above a moved chat. It stands in for the game's weapon list: while a mod hides that list, every mod's WeaponList elements stack on past the loadout.",
              "name": "AddLoadout",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudLoadout"
              }
            },
            {
              "id": "AddSegmentBar(string, Func<float>, int, HudSlot?)",
              "summary": "A compact segmented bar for the top of the screen (see HudSegmentBar). Default slot: top centre.",
              "name": "AddSegmentBar",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "value",
                  "type": "Func<float>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "segments",
                  "type": "int",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudSegmentBar"
              }
            },
            {
              "id": "AddArcGauge(string, Func<float>, ArcSide)",
              "summary": "A half arc beside the crosshair (see HudArcGauge; region World).",
              "name": "AddArcGauge",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "value",
                  "type": "Func<float>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "side",
                  "type": "ArcSide",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudArcGauge"
              }
            },
            {
              "id": "AddBearingArc(string, int, HudSlot?)",
              "summary": "Contacts round the crosshair (see HudBearingArc; region World).",
              "name": "AddBearingArc",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "capacity",
                  "type": "int",
                  "summary": "",
                  "default": 24
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudBearingArc"
              }
            },
            {
              "id": "AddSilhouette(string, IReadOnlyList<Sprite?>, HudSlot?)",
              "summary": "A hull status disc of same-size layers (see HudSilhouette). Default slot: bottom left. A missing picture (null, for example an art file that was not found) is logged as an error and its layer is not drawn; the other layers keep their index.",
              "name": "AddSilhouette",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "layers",
                  "type": "IReadOnlyList<Sprite?>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudSilhouette"
              }
            },
            {
              "id": "AddObjectives(string, HudSlot?)",
              "summary": "The game's objectives in the kit's style (see HudObjectives). Default slot: the notices corner.",
              "name": "AddObjectives",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudObjectives"
              }
            },
            {
              "id": "AddInteraction(string)",
              "summary": "The game's interaction prompt under the crosshair (see HudInteraction; region World).",
              "name": "AddInteraction",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudInteraction"
              }
            },
            {
              "id": "AddSubtitles(string)",
              "summary": "The game's subtitles low in the middle (see HudSubtitles; region World).",
              "name": "AddSubtitles",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudSubtitles"
              }
            },
            {
              "id": "AddTeammates(string, HudSlot?)",
              "summary": "The other players (see HudTeammates). Default slot: bottom left.",
              "name": "AddTeammates",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudTeammates"
              }
            },
            {
              "id": "AddLabel(string, Func<string>[])",
              "summary": "A few short lines of small text (see HudLabel). Default slot: top left.",
              "name": "AddLabel",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "lines",
                  "type": "Func<string>[]",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudLabel"
              }
            },
            {
              "id": "AddLabel(string, HudSlot?, Func<string>[])",
              "summary": "A few short lines of small text in slot (null: the top left corner; see HudLabel).",
              "name": "AddLabel",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "lines",
                  "type": "Func<string>[]",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudLabel"
              }
            },
            {
              "id": "AddTimeline(string)",
              "summary": "A time bar across the bottom of the screen (HudTimeline), hidden until you set Visible. Null (logged) when the name cannot be used or is taken.",
              "name": "AddTimeline",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudTimeline"
              }
            },
            {
              "id": "AddWheel(string, KeyAction)",
              "summary": "A radial wheel opened by key (see HudWheel); give it pages with SetPages and listen to Chosen. Hidden until the key opens it. Register the key with Hold as its default to get \"hold to open, release to choose\".",
              "name": "AddWheel",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "key",
                  "type": "KeyAction",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudWheel"
              }
            },
            {
              "id": "AddBootMessage(string, BootMessageBeats, BootMessageLook, HudSlot?)",
              "summary": "A power-on message with your beats, colours and words (see HudBootMessage). Default slot: the centre banner, priority 100, sized by look.",
              "name": "AddBootMessage",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "beats",
                  "type": "BootMessageBeats",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "look",
                  "type": "BootMessageLook",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudBootMessage"
              }
            },
            {
              "id": "AddSkillSlot(string, Func<float>, float, UIText?, HudSlot?)",
              "summary": "An ability slot (see HudSkillSlot). remaining is read every frame and returns the seconds left (0 when ready); cooldown is the full length. Default slot: bottom left.",
              "name": "AddSkillSlot",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "remaining",
                  "type": "Func<float>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "cooldown",
                  "type": "float",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "key",
                  "type": "UIText?",
                  "summary": "",
                  "default": "null"
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudSkillSlot"
              }
            },
            {
              "id": "AddKeyHint(string, KeyCode, UIText, HudSlot?)",
              "summary": "A key prompt for a keyboard or mouse key (named the way the game names it). Default slot: under the weapon list.",
              "name": "AddKeyHint",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "key",
                  "type": "KeyCode",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "label",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudKeyHint"
              }
            },
            {
              "id": "AddKeyHint(string, InputAction, UIText, HudSlot?)",
              "summary": "A key prompt for a game action, showing whatever the player has bound to it. Default slot: under the weapon list.",
              "name": "AddKeyHint",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "action",
                  "type": "InputAction",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "label",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudKeyHint"
              }
            },
            {
              "id": "AddKeyHint(string, KeyAction, UIText, HudSlot?)",
              "summary": "A key prompt for one of your key actions (AddKeyAction), showing the key the player gave it. Default slot: under the weapon list.",
              "name": "AddKeyHint",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "action",
                  "type": "KeyAction",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "label",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudKeyHint"
              }
            },
            {
              "id": "AddHintLine(string, HudSlot?)",
              "summary": "A line of mixed words and key boxes (\"Release [F] to cancel\"); give the parts with Set. Default slot: under the weapon list. To put the same line inside an element of your own, use HintRow.",
              "name": "AddHintLine",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "HudHintLine"
              }
            },
            {
              "id": "AddPlaced(string, HudPlacement)",
              "summary": "A readout at a place you choose (see HudPlaced): text, a thin bar, a row of cells or a clock in the game's HUD look. It takes no room in any region: it may overlap the game's HUD or other elements.",
              "name": "AddPlaced",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "placement",
                  "type": "HudPlacement",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudPlaced"
              }
            },
            {
              "id": "AddCommandList(string, UIText, UIText, UIText, int, int)",
              "summary": "The list of commands called by typing an arrow code (see HudCommandList). Hidden until you call Show. It stands at the right edge of the screen, its middle on the middle of the screen, clear of the rest of the HUD (CommandDock); while it shows, the game's glass reflection is held off (a hide claim named name + Glass).",
              "name": "AddCommandList",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "title",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "heldTitle",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "heldLabel",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "maxItems",
                  "type": "int",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "maxSteps",
                  "type": "int",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudCommandList"
              }
            },
            {
              "id": "AddBanner(string, int)",
              "summary": "A claim on the shared banner (big text a little above the middle of the screen). Banners of every mod share one slot: priority decides against other mods' banners (higher takes the slot, equal or lower waits).",
              "name": "AddBanner",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "priority",
                  "type": "int",
                  "summary": "",
                  "default": 0
                }
              ],
              "details": {
                "returns": "HudBanner"
              }
            },
            {
              "id": "AddNotices(string)",
              "summary": "A claim on the shared notice list in the top left corner (under where the game draws its objective).",
              "name": "AddNotices",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudNotices"
              }
            },
            {
              "id": "AddWaypoints(string, int)",
              "summary": "World points this mod places (see HudWaypoints): up to capacity (1..64) marks with a label, distance and an arrow on the screen's edge while off screen, and, for points that ask, a mark on every bearing ring that shows the compass. Region World.",
              "name": "AddWaypoints",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "capacity",
                  "type": "int",
                  "summary": "",
                  "default": 16
                }
              ],
              "details": {
                "returns": "HudWaypoints"
              }
            },
            {
              "id": "AddLobbyButton(string, UIText, Action<CM_PlayerLobbyBar>, Func<string>?, Func<CM_PlayerLobbyBar, bool>?)",
              "summary": "Adds a button to the lobby player bar, under the game's APPAREL button. Buttons from all mods stack downwards in the order of their full IDs.",
              "name": "AddLobbyButton",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "title",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "onClick",
                  "type": "Action<CM_PlayerLobbyBar>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "note",
                  "type": "Func<string>?",
                  "summary": "",
                  "default": "null"
                },
                {
                  "name": "visible",
                  "type": "Func<CM_PlayerLobbyBar, bool>?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "LobbyButton"
              }
            },
            {
              "id": "AddMenuBarButton(string, UIText, Action)",
              "summary": "Adds a button to the top menu bar of every page, after the game's left-hand buttons (SETTINGS, RUNDOWN, LOADOUT). Buttons from all mods follow in the order of their full IDs.",
              "name": "AddMenuBarButton",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "title",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "onClick",
                  "type": "Action",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "MenuBarButton"
              }
            },
            {
              "id": "AddMenuBarPage(string, UIText, Action<MenuBarPage>, Action?)",
              "summary": "Adds a menu bar button (as AddMenuBarButton) that opens and closes a page: a window under the menu bar with title as its heading, closed by its close box, a click outside it or the button again. Its content is yours: build is called the first time the page is opened from a page's menu bar (so once per game page it is opened on) and fills Root, for example with AddText. When the language changes the page is built again, so text keys given to the page show in the new language.",
              "name": "AddMenuBarPage",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "title",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "build",
                  "type": "Action<MenuBarPage>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "clicked",
                  "type": "Action?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "MenuBarButton"
              }
            },
            {
              "id": "AddMenuBarScreen(string, UIText, Action<MenuScreen>, Action?)",
              "summary": "Adds a menu bar button that opens a full screen on the game's settings page, built from that page's own pieces (see MenuScreen): build adds sections, windows, rows and buttons every time it opens, so what it shows is current. Call Rebuild to build it again while it is open; any page change closes it.",
              "name": "AddMenuBarScreen",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "title",
                  "type": "UIText",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "build",
                  "type": "Action<MenuScreen>",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "clicked",
                  "type": "Action?",
                  "summary": "",
                  "default": "null"
                }
              ],
              "details": {
                "returns": "MenuBarButton"
              }
            },
            {
              "id": "AddHud(string, HudSlot, Action<HudElement>)",
              "summary": "Adds an element to the in-level HUD in slot's region. ForgeUI places the elements of every mod: a region stacks its elements by priority with a gap, keeps them clear of each other and of the game's weapon list and vitals, and collapses (and logs) the lowest priority ones when it is full. build runs each time the game creates its HUD (every level) and puts your pieces under Root with AddText and AddSprite, which copy the game's own HUD text and sprites, so they are drawn by the game's HUD camera, sway with the HUD and hide with it. Draw from the root in the region's direction (FlowX, FlowY).",
              "name": "AddHud",
              "parameters": [
                {
                  "name": "name",
                  "type": "string",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "slot",
                  "type": "HudSlot",
                  "summary": "",
                  "required": true
                },
                {
                  "name": "build",
                  "type": "Action<HudElement>",
                  "summary": "",
                  "required": true
                }
              ],
              "details": {
                "returns": "HudElement"
              }
            }
          ]
        },
        {
          "id": "icons",
          "title": "Game icons",
          "entries": [
            {
              "id": "Game:symbol_hostile",
              "summary": "The hollow triangle on an enemy's tag marker."
            },
            {
              "id": "Game:cellUI_SmallTriangleFill",
              "summary": "A small filled triangle."
            },
            {
              "id": "Game:CircleBigMiddleSize_Fill",
              "summary": "A filled circle."
            },
            {
              "id": "Game:GUIX_Detail_BoxFilled_AA_Centered",
              "summary": "A filled square."
            }
          ]
        }
      ]
    },
    {
      "id": "audio",
      "title": "Audio",
      "namespace": "ForgeAudio",
      "groups": [
        {
          "id": "categories",
          "title": "Categories",
          "entries": [
            {
              "id": "ui",
              "summary": "menus, prompts, confirmations and warnings",
              "details": {
                "limit": 8
              }
            },
            {
              "id": "weapon",
              "summary": "gunfire, reloads and weapon handling",
              "details": {
                "limit": 16
              }
            },
            {
              "id": "explosion",
              "summary": "blasts and impacts",
              "details": {
                "limit": 10
              }
            },
            {
              "id": "debris",
              "summary": "falling debris, shrapnel and settling rubble",
              "details": {
                "limit": 12
              }
            },
            {
              "id": "ambience",
              "summary": "beds, hums and room tones",
              "details": {
                "limit": 8
              }
            },
            {
              "id": "voice",
              "summary": "speech and radio voices",
              "details": {
                "limit": 4
              }
            },
            {
              "id": "vehicle",
              "summary": "suits, drop pods and other vehicles: steps, servos, engines",
              "details": {
                "limit": 48
              }
            },
            {
              "id": "device",
              "summary": "machines in the world: beacons, turrets, supply pods, terminals",
              "details": {
                "limit": 10
              }
            },
            {
              "id": "music",
              "summary": "music",
              "details": {
                "limit": 2
              }
            }
          ]
        },
        {
          "id": "settings",
          "title": "cues.forge",
          "entries": [
            {
              "id": "buses",
              "summary": "A bus groups cues and names their global category; defined under \"buses\" and referenced by each cue.",
              "parameters": [
                {
                  "name": "category",
                  "type": "choice",
                  "summary": "The global category the bus belongs to; all mods share each category's voice limit.",
                  "required": true,
                  "values": [
                    "ui",
                    "weapon",
                    "explosion",
                    "debris",
                    "ambience",
                    "voice",
                    "vehicle",
                    "device",
                    "music"
                  ]
                },
                {
                  "name": "gain",
                  "type": "number",
                  "summary": "Volume of every cue on the bus, linear. Use either gain or gainDb.",
                  "min": 0,
                  "max": 4,
                  "default": 1
                },
                {
                  "name": "gainDb",
                  "type": "number",
                  "summary": "Volume of every cue on the bus, in decibels. Use either gain or gainDb.",
                  "min": -60,
                  "max": 12,
                  "unit": "dB"
                },
                {
                  "name": "seats",
                  "type": "integer",
                  "summary": "How many sounds of the bus may play at once from one emitter; the weakest are faded out for a stronger newcomer.",
                  "min": 1,
                  "max": 64,
                  "default": 0,
                  "unit": "sounds"
                },
                {
                  "name": "duck",
                  "type": "object",
                  "summary": "Lowers other categories while a sound of this bus plays."
                },
                {
                  "name": "duck.categories",
                  "type": "list",
                  "summary": "The categories to lower.",
                  "required": true,
                  "min": 1,
                  "max": 9,
                  "values": [
                    "ui",
                    "weapon",
                    "explosion",
                    "debris",
                    "ambience",
                    "voice",
                    "vehicle",
                    "device",
                    "music"
                  ]
                },
                {
                  "name": "duck.db",
                  "type": "number",
                  "summary": "How far to lower them.",
                  "min": 0.5,
                  "max": 48,
                  "default": 6,
                  "unit": "dB"
                }
              ]
            },
            {
              "id": "cues",
              "summary": "One playable sound; defined under \"cues\".",
              "parameters": [
                {
                  "name": "bus",
                  "type": "name",
                  "summary": "The bus the cue plays on; it must be defined in \"buses\". The bus decides the category.",
                  "required": true
                },
                {
                  "name": "layers",
                  "type": "list",
                  "summary": "The layers mixed into the cue. Without it the cue plays the .ogg file of the same name.",
                  "min": 1,
                  "max": 8
                },
                {
                  "name": "gain",
                  "type": "number-or-range",
                  "summary": "Volume, linear; a [min, max] pair lets each play pick between them. Use either gain or gainDb.",
                  "min": 0,
                  "max": 4,
                  "default": 1
                },
                {
                  "name": "gainDb",
                  "type": "number-or-range",
                  "summary": "Volume in decibels; a [min, max] pair lets each play pick between them.",
                  "min": -60,
                  "max": 12,
                  "unit": "dB"
                },
                {
                  "name": "pitch",
                  "type": "number-or-range",
                  "summary": "Playback speed as a factor; a [min, max] pair lets each play pick between them.",
                  "min": 0.1,
                  "max": 3,
                  "default": 1
                },
                {
                  "name": "loop",
                  "type": "boolean",
                  "summary": "Repeats seamlessly. A loop has exactly one layer with only clips and gain.",
                  "default": false
                },
                {
                  "name": "priority",
                  "type": "integer",
                  "summary": "Higher priority wins when voices run out; 200 and up counts as a warning.",
                  "min": 0,
                  "max": 255,
                  "default": 100
                },
                {
                  "name": "maxVoices",
                  "type": "integer",
                  "summary": "How many plays of the cue may sound at once.",
                  "min": 1,
                  "max": 256,
                  "default": 8
                },
                {
                  "name": "maxPerEmitter",
                  "type": "integer",
                  "summary": "How many plays of the cue may sound at once from one emitter; at most maxVoices.",
                  "min": 1,
                  "max": 256,
                  "default": 8
                },
                {
                  "name": "minInterval",
                  "type": "number",
                  "summary": "The shortest gap between two plays of the cue.",
                  "min": 0,
                  "max": 60,
                  "default": 0,
                  "unit": "s"
                },
                {
                  "name": "environment",
                  "type": "boolean",
                  "summary": "Whether room acoustics (occlusion, room tone) apply.",
                  "default": true
                },
                {
                  "name": "maxSeconds",
                  "type": "number",
                  "summary": "The longest the cue may last; the mix is cut there and fades out. 0 means no cap.",
                  "min": 0.05,
                  "max": 60,
                  "default": 0,
                  "unit": "s"
                },
                {
                  "name": "place",
                  "type": "choice",
                  "summary": "Where the sound sits: in the listener's head (2d), at a world point (world) or following an object (follow); auto keeps what the caller supplied. A { \"self\", \"other\" } pair sets the local player's own sounds and everyone else's separately.",
                  "default": "auto",
                  "values": [
                    "auto",
                    "2d",
                    "world",
                    "follow"
                  ]
                },
                {
                  "name": "space",
                  "type": "object",
                  "summary": "How the cue is heard in space; see the space settings."
                }
              ]
            },
            {
              "id": "layers",
              "summary": "One layer of a cue, listed in the cue's \"layers\".",
              "parameters": [
                {
                  "name": "clips",
                  "type": "list",
                  "summary": "The .ogg files of the layer; each play picks one.",
                  "required": true,
                  "min": 1,
                  "max": 32
                },
                {
                  "name": "offsetMs",
                  "type": "number",
                  "summary": "Delay before the layer starts.",
                  "min": 0,
                  "max": 60000,
                  "default": 0,
                  "unit": "ms"
                },
                {
                  "name": "gain",
                  "type": "number",
                  "summary": "Layer volume, linear. Use either gain or gainDb.",
                  "min": 0,
                  "max": 4,
                  "default": 1
                },
                {
                  "name": "gainDb",
                  "type": "number",
                  "summary": "Layer volume in decibels. Use either gain or gainDb.",
                  "min": -60,
                  "max": 12,
                  "unit": "dB"
                },
                {
                  "name": "range",
                  "type": "list",
                  "summary": "[start, end] seconds of the clip to use.",
                  "min": 0,
                  "max": 600,
                  "unit": "s"
                },
                {
                  "name": "fadeInMs",
                  "type": "number",
                  "summary": "Fade-in length.",
                  "min": 0,
                  "max": 10000,
                  "default": 0,
                  "unit": "ms"
                },
                {
                  "name": "fadeOutMs",
                  "type": "number",
                  "summary": "Fade-out length.",
                  "min": 0,
                  "max": 10000,
                  "default": 0,
                  "unit": "ms"
                },
                {
                  "name": "pitch",
                  "type": "number-or-range",
                  "summary": "Layer playback speed as a factor.",
                  "min": 0.1,
                  "max": 3,
                  "default": 1
                },
                {
                  "name": "distance",
                  "type": "object",
                  "summary": "The listener distances inside which the layer plays, so a far layer can replace the near one."
                },
                {
                  "name": "distance.min",
                  "type": "number",
                  "summary": "Nearest distance.",
                  "min": 0,
                  "max": 100000,
                  "default": 0,
                  "unit": "m"
                },
                {
                  "name": "distance.max",
                  "type": "number",
                  "summary": "Farthest distance; unbounded when omitted.",
                  "min": 0,
                  "max": 100000,
                  "unit": "m"
                },
                {
                  "name": "lowpassHz",
                  "type": "number",
                  "summary": "Low-pass cutoff; 0 leaves the layer unfiltered.",
                  "min": 50,
                  "max": 20000,
                  "default": 0,
                  "unit": "Hz"
                }
              ]
            },
            {
              "id": "space",
              "summary": "How a cue is heard in space; the cue's \"space\".",
              "parameters": [
                {
                  "name": "near",
                  "type": "number",
                  "summary": "Distance up to which the sound is at full volume.",
                  "min": 0.01,
                  "max": 10000,
                  "default": 2,
                  "unit": "m"
                },
                {
                  "name": "far",
                  "type": "number",
                  "summary": "Distance beyond which the sound is silent (when cull is on); greater than near.",
                  "min": 0.01,
                  "max": 10000,
                  "default": 30,
                  "unit": "m"
                },
                {
                  "name": "curve",
                  "type": "choice",
                  "summary": "Loudness by distance: \"linear\", \"log\", or 2 to 32 [metres, gain] points with increasing metres.",
                  "default": "linear",
                  "values": [
                    "linear",
                    "log"
                  ]
                },
                {
                  "name": "blend",
                  "type": "number",
                  "summary": "0 hears the sound flat (no distance loss, no panning), 1 fully positioned.",
                  "min": 0,
                  "max": 1,
                  "default": 1
                },
                {
                  "name": "spread",
                  "type": "number",
                  "summary": "How much the sound widens, which reduces panning.",
                  "min": 0,
                  "max": 180,
                  "default": 0,
                  "unit": "degrees"
                },
                {
                  "name": "doppler",
                  "type": "number",
                  "summary": "How strongly relative motion shifts the pitch.",
                  "min": 0,
                  "max": 5,
                  "default": 0
                },
                {
                  "name": "cull",
                  "type": "boolean",
                  "summary": "Beyond far the sound is silent and takes no voice.",
                  "default": true
                }
              ]
            }
          ]
        }
      ]
    },
