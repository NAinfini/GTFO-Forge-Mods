                  "method": "SetGUIMessage"
                },
                {
                  "module": "GameHooks.PuzzleState",
                  "type": "ChainedPuzzles.ChainedPuzzleInstance",
                  "method": "OnStateChange"
                },
                {
                  "module": "GameHooks.ResourceContainerState",
                  "type": "LevelGeneration.LG_ResourceContainer_Sync",
                  "method": "OnStateChange"
                },
                {
                  "module": "GameHooks.GeneratorState",
