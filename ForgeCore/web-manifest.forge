{
  "kind": "forge-library-manifest",
  "schemaVersion": "1.0.0",
  "library": "ForgeCore",
  "packageName": "NAinfini-ForgeCore",
  "version": "1.0.0",
  "parts": [
    {
      "id": "core",
      "title": "Core",
      "namespace": "ForgeCore",
      "groups": [
        {
          "id": "modules",
          "title": "Modules",
          "entries": [
            {
              "id": "Assets",
              "summary": "Loads asset bundles (each file once, reused afterwards, or over several frames for a caller that unloads), returns assets and shader bytes; a bad bundle or a missing asset fails explicitly and is logged."
            },
            {
              "id": "Log",
              "summary": "A log source per mod ID; only errors are written, the same error once with counts at 1, 10 and 100; formats a number or a position for a message."
            },
            {
              "id": "Settings",
              "summary": "Binds BepInEx configuration entries per mod ID and tells the mod when one changes at run time."
            },
            {
              "id": "Pool",
              "summary": "A fixed-capacity object pool that prewarms on demand and allocates nothing on take or return."
            },
            {
              "id": "Net",
              "summary": "Per-mod network channels with automatic message-format fingerprints (a mismatching player is refused on both sides), reliable or droppable delivery, host broadcast, point to point, per-player lobby data and late-join resend.",
              "patches": [
                {
                  "module": "Net.ReplicationMisses",
                  "type": "SNetwork.SNet_Replication",
                  "method": "RecieveBytes"
                },
                {
                  "module": "Net.ReplicationMisses",
                  "type": "SNetwork.SNet_Replication",
                  "method": "AssignReplicatorKey"
                }
              ]
            },
            {
              "id": "Store",
              "summary": "Local progress as one JSON file per mod; a file that cannot be read is reported and never overwritten."
            },
            {
              "id": "InputLease",
              "summary": "Takes over game input actions for the local player; leases stack and are released at level cleanup and when the player goes down.",
              "patches": [
                {
                  "module": "InputLease.Interactions",
                  "type": "PlayerInteraction",
                  "method": "set_CameraRayInteractionEnabled"
                },
                {
                  "module": "InputLease.Interactions",
                  "type": "PlayerInteraction",
                  "method": "set_SphereCheckInteractionEnabled"
                },
                {
                  "module": "InputLease.Interactions",
                  "type": "PlayerInteraction",
                  "method": "set_LadderInteractionEnabled"
                }
              ]
            },
            {
              "id": "GameEvents",
              "summary": "Main-thread events for host change, text language, end of a level, checkpoint reload, the local player going down, the lobby opening or closing and the expedition being chosen (host and clients).",
              "patches": [
                {
                  "module": "GameEvents.Language",
                  "type": "Localization.GameDataTextLocalizationService",
                  "method": "SetCurrentLanguage"
                },
                {
                  "module": "GameEvents.ExpeditionSelected",
                  "type": "RundownManager",
                  "method": "MasterSelectActiveExpedition"
                },
                {
                  "module": "GameEvents.ExpeditionSelected",
                  "type": "RundownManager",
                  "method": "SetActiveExpedition"
                }
              ]
            },
            {
              "id": "Enemies",
              "summary": "Tracks live enemies, queries nearby enemies (also only those in sight, with their aim point), reads the four alert levels, requests enemy spawns, leases slowdowns and slows every enemy inside a zone for a time."
            },
            {
              "id": "ColliderQuery",
              "summary": "Sphere queries over colliders with a reusable buffer; a full buffer is reported as truncated, never as complete."
            },
            {
              "id": "Level",
              "summary": "Finds the course node and dimension of a position, finds a free stand spot near an object, finds a walkable path, a line of sight and a blocked move between points, looks up dimensions, zones and areas, finds the in-level agent of a player by lookup, and reads the active expedition.",
              "patches": [
                {
                  "module": "Level.StackedVolumes",
                  "type": "AIGraph.AIG_GeomorphNodeVolume",
                  "method": "TryGetGeomorphVolume"
                }
              ]
            },
            {
              "id": "HoldPoint",
              "summary": "The game's timed hold point (Interact_Timed): sets up the prompt, duration and callbacks, and shuts a point so it stays shut when the game switches it on again, until it is opened.",
              "patches": [
                {
                  "module": "HoldPoint.Shut",
                  "type": "Interact_Timed",
                  "method": "SetActive"
                }
              ]
            },
            {
              "id": "Il2CppArrays",
              "summary": "Copies whole game arrays to and from managed arrays and uploads texture pixels in one write."
            },
            {
              "id": "PlayerStats",
              "summary": "The local player's walk speed, carry slowdown, jump, stamina cost and hit flinch through the game's own paths; each hook goes on with its first subscriber and every subscriber is asked.",
              "patches": [
                {
                  "module": "PlayerStats.Walk",
                  "type": "PLOC_Base",
                  "method": "GetHorizontalVelocityFromInput"
                },
                {
                  "module": "PlayerStats.Jump",
                  "type": "PLOC_Jump",
                  "method": "Enter"
                },
                {
                  "module": "PlayerStats.Rise",
                  "type": "PLOC_Base",
                  "method": "UpdateVerticalVelocityInAir"
                },
                {
                  "module": "PlayerStats.Stamina",
                  "type": "PlayerStamina",
                  "method": "UseStamina"
                },
                {
                  "module": "PlayerStats.Flinch",
                  "type": "Dam_PlayerDamageLocal",
                  "method": "Hitreact"
                }
              ]
            },
            {
              "id": "CarrySlot",
              "summary": "Moves the heavy object of the in-level carry slot between the local player's hands and back through the game's synced wield request, drops one on the back when the player falls, shows another player's on their body, and sets a heavy object's pick-up hold time."
            },
            {
              "id": "PlayerNoise",
              "summary": "Makes sleeping enemies hear a player's movement noise as a multiple of its distance; leases end with the level.",
              "patches": [
                {
                  "module": "PlayerNoise",
                  "type": "Enemies.EnemyDetection",
                  "method": "UpdateDirectionDistanceToTarget_Hibernate"
                }
              ]
            },
            {
              "id": "Combat",
              "summary": "The game's own damage, push, melee, explosion, force and noise requests, reporting what the game actually settled, a bullet kill event, a shot from a point at a collider settled as a stock bullet, the bullet ray that steps over the shooter's own colliders, plus which receiver a collider belongs to."
            },
            {
              "id": "Gear",
              "summary": "Swaps the local player's gun with its assets preloaded, writes ammunition back through the game, arbitrates the special weapon slot, and limits which gears players may choose (one patch on the game's slot offer and its local equip entry for every package).",
              "patches": [
                {
                  "module": "Gear.SpecialSlot",
                  "type": "Player.PlayerAmmoStorage",
                  "method": "PickupAmmo"
                },
                {
                  "module": "Gear.SpecialSlot",
                  "type": "Player.PlayerAmmoStorage",
                  "method": "NeedWeaponAmmo"
                },
                {
                  "module": "Gear.Reload",
                  "type": "Gear.BulletWeapon",
                  "method": "get_ReloadTime"
                },
                {
                  "module": "Gear.Offers",
                  "type": "Gear.GearManager",
                  "method": "GetAllGearForSlot"
                },
                {
                  "module": "Gear.Offers",
                  "type": "Player.PlayerBackpackManager",
                  "method": "EquipLocalGear"
                },
                {
                  "module": "Gear.Parts",
                  "type": "Gear.GearPartSpawner+_SpawnAllParts_d__15",
                  "method": "MoveNext"
                }
              ]
            },
            {
              "id": "PlayerHits",
              "summary": "The one patch on the game's player hit path (OnIncomingDamage, ModifyInfection): mods redirect the damage of a hit, refuse an infection write or read both through registrations instead of patching the methods themselves.",
              "patches": [
                {
                  "module": "PlayerHits",
                  "type": "Dam_PlayerDamageBase",
                  "method": "OnIncomingDamage"
                },
                {
                  "module": "PlayerHits",
                  "type": "Dam_PlayerDamageBase",
                  "method": "ModifyInfection"
                }
              ]
            },
            {
              "id": "Compact",
              "summary": "Allocation-free compact encoding: variable-length and zig-zag integers, deltas, range quantization and smallest-three quaternions; a malformed read throws, never guesses."
            },
            {
              "id": "ChunkLog",
              "summary": "An append-only file of independently compressed, checksummed chunks with a trailing index; after a crash the reader scans chunk headers and keeps every whole chunk, and another format version is refused with the difference named."
            },
            {
              "id": "Items",
              "summary": "Spawns an item pickup the way the game does, in play as well as before it; the Spawned event reports every item the game spawns, so no other package patches the game's spawn method.",
              "patches": [
                {
                  "module": "Items.Spawned",
                  "type": "ItemReplicationManager",
                  "method": "OnItemSpawn"
                }
              ]
            },
            {
              "id": "SoloDrop",
              "summary": "Starts one chosen expedition as a private host with chosen seeds, alone or with up to three of the game's bots, through the game's own menu calls; stops at the first unexpected state and never retries."
            },
            {
              "id": "InstalledPlugins",
              "summary": "The loaded BepInEx plugins with version and DLL hash, and one fingerprint over them."
            },
            {
              "id": "DataBlocks",
              "summary": "Adds new gear and item data blocks to the game's tables; an ID already in use is refused."
            },
            {
              "id": "Frame",
              "summary": "Per-frame callbacks for mods (update, late update, quit) run from ForgeCore's one driver; a callback that throws is reported once and never stops the others."
            },
            {
              "id": "Patches",
              "summary": "Puts a mod's own Harmony patches on at first use and keeps them, so a session that never uses the feature never pays for them."
            },
            {
              "id": "StrictJson",
              "summary": "Strict reading of a JSON object: unknown or repeated fields are refused, a wrong type names its field, a number outside its range is refused, never clamped; also canonical JSON."
            },
            {
              "id": "GameHooks",
              "summary": "The game methods that more than one package reads, each patched here once and handed to every subscriber around the game's own body: door, reactor, scan, container, generator, pickup and terminal state callbacks, noise, scout and wave events, a player's damage receive entries, a revive, the four firing bodies and the weapon ray casts, push, sentry placement and every sentry lifecycle step, mine placement, item spawn, level cleanup, marker and prefab placement, survival waves, the end and the failure check of an expedition, enemy setup, death, despawn, destruction, mode change, spawn sync, limb break, received damage and the bullet and melee receive entries, the local player's death, the bullet hit entry, weapon wield and item unwield, dry fire, gear assembly (also a synced gun's), reload start and end, the attached flashlight switch, the C-foam burst, a throwable's throw, the deployed marker, sentry spawn, the objective panel and intel messages, host migration, and the game event log; no package patches these methods itself.",
              "patches": [
                {
                  "module": "GameHooks.EnemyBulletReceived",
                  "type": "Dam_EnemyDamageBase",
                  "method": "ReceiveBulletDamage"
                },
                {
                  "module": "GameHooks.EnemyMeleeReceived",
                  "type": "Dam_EnemyDamageBase",
                  "method": "ReceiveMeleeDamage"
                },
                {
                  "module": "GameHooks.WeakDoorState",
