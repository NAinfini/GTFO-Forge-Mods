# hit reacts: 8 big Strikers, two seconds of fire in every segment
clear enemies
wait 3s
teleport 35.5 0.06 50.5
look 35.5 0.6 60
spawn Striker_Big 4 at=front:7
spawn Striker_Big 4 at=front:10
wield primary
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-A-1"
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" true
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" false
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" true
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" false
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" true
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" false
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-B-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" true
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Mark "fire-C6-A-5"
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" false
ammo fill
fire 2s
wait 6s
call static:ForgePerformance.Crowd.PerformanceControl Read as=final
clear enemies
call static:ForgePerformance.Crowd.PerformanceControl Mark "end"
expect log --all !contains "Exception"
