call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C4-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C4-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C4-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C4-B-2"
