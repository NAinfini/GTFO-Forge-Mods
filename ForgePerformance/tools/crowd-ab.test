# ForgePerformance A/B comparison: each option alternates off (A) and on (B) in equal 8-second segments, A B A B A B A B A,
# over a fixed crowd: 40 sleeping Strikers, then the same 40 awake around a god-mode player, then 8 big Strikers under fire
# for HitReactKeepsAgent. AvoidanceQuality is measured with AvoidanceType 0 (the game already uses 1). The split-* labels
# are plain 16-second windows for the main-thread split. Needs the probe on (and ForgeDevelopment's performance log for
# its phases); read with tools/analyze_probe.py <log> --forgedev <ForgeDevelopment log>. PLACE: an open room of V1 A1.
# Every segment runs the same commands, so A and B segments last equally long.
god on
clear enemies
teleport 35.5 0.06 50.5
look 35.5 0.6 60
call static:ForgePerformance.Crowd.PerformanceControl Set "SetupRendererLookup" false
call static:ForgePerformance.Crowd.PerformanceControl Set "SpawnFrameDefer" false
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" false
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
call static:ForgePerformance.Crowd.PerformanceControl Set "ClientHiddenSyncThrottle" false
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" false
call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" false
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" false
call static:ForgePerformance.Crowd.PerformanceControl Set "HitReactKeepsAgent" false
call static:ForgePerformance.Crowd.PerformanceControl Value "AvoidanceType" 0
call static:ForgePerformance.Crowd.PerformanceControl Read as=before
call static:ForgePerformance.Crowd.PerformanceControl Mark "split-empty"
wait 16s

# 40 sleepers; the registry should grow by exactly 40 (one entry per enemy however often it is set up)
spawn Striker 4 at=front:3 mode=hibernate
spawn Striker 4 at=front:5 mode=hibernate
spawn Striker 4 at=front:7 mode=hibernate
spawn Striker 4 at=front:9 mode=hibernate
spawn Striker 4 at=front:11 mode=hibernate
spawn Striker 4 at=front:13 mode=hibernate
spawn Striker 4 at=front:15 mode=hibernate
spawn Striker 4 at=front:17 mode=hibernate
spawn Striker 4 at=front:19 mode=hibernate
spawn Striker 4 at=front:21 mode=hibernate
wait 5s
call static:ForgePerformance.Crowd.PerformanceControl Read as=sleepers
call static:ForgePerformance.Crowd.PerformanceControl Mark "split-sleep"
wait 16s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-B-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "sleep-B3-A-5"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s

# the same 40 awake; god mode keeps the player alive and nobody shoots, so the count stays fixed
noise 40
wait 15s
call static:ForgePerformance.Crowd.PerformanceControl Read as=awake
call static:ForgePerformance.Crowd.PerformanceControl Mark "split-awake"
wait 16s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-B-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B3-A-5"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarSkinQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-B-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-B2-A-5"
call static:ForgePerformance.Crowd.PerformanceControl Set "FarAnimatorThrottle" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-B-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C1-A-5"
call static:ForgePerformance.Crowd.PerformanceControl Set "UpdateBudgets" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C3-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C3-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C3-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C3-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C3-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C3-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "awake-C3-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "AvoidanceQuality" false
wait 8s
