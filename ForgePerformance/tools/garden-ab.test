# ForgePerformance A/B in R8A1 ("Order") zone 7, the heaviest garden zone. Needs Probe=true. Every option alternates off (A)
# and on (B) in equal segments, A B A B A B A B A; read with tools/analyze_probe.py. Sections: the 40 s after the teleport
# into zone 7 (spike), the empty zone with IrfPhysicsHalfRate, 48 aggressive Strikers around a god-mode player with
# TentacleLimitErrorFold, then chases between two areas of the zone for PathfindingIterations: each chase starts
# when the player teleports away and ends when 40 enemies stand within 6 m (ChaseState answers done, or done-timeout after 45 s).
# Options that are not under test stay off.
level 35 1 0
god on
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" false
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" false
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" false
call static:ForgePerformance.Crowd.PerformanceControl Read as=before
call static:ForgePerformance.Crowd.PerformanceControl Mark "tele-0"
teleport zone=0/MainLayer/7 area=0 as=zone7
wait 10s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tele-10"
wait 10s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tele-20"
wait 10s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tele-30"
wait 10s
player as=zone7_pos
call static:ForgePerformance.Crowd.PerformanceControl Mark "split-empty"
wait 16s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-B-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "irf-A-5"
call static:ForgePerformance.Crowd.PerformanceControl Set "IrfPhysicsHalfRate" false
wait 8s
spawn Striker 12 at=front:6 mode=aggressive as=load1
spawn Striker 12 at=front:9 mode=aggressive as=load2
spawn Striker 12 at=front:12 mode=aggressive as=load3
spawn Striker 12 at=front:15 mode=aggressive as=load4
wait 10s
enemies as=load_count
call static:ForgePerformance.Crowd.PerformanceControl Mark "split-load"
wait 16s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-A-1"
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-B-1"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-A-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-B-2"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-A-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-B-3"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-A-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-B-4"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" true
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Mark "tentacle-A-5"
call static:ForgePerformance.Crowd.PerformanceControl Set "TentacleLimitErrorFold" false
wait 8s
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" false
call static:ForgePerformance.Crowd.PerformanceControl Mark "path-A-1"
teleport zone=0/MainLayer/7 area=1
call static:ForgePerformance.Crowd.PerformanceControl Chase 40 6.0
call static:ForgePerformance.Crowd.PerformanceControl ChaseState --until ChaseState done --timeout 60
call static:ForgePerformance.Crowd.PerformanceControl ChaseState as=chase-path-1
wait 4s
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" true
call static:ForgePerformance.Crowd.PerformanceControl Mark "path-B-2"
teleport zone=0/MainLayer/7 area=0
call static:ForgePerformance.Crowd.PerformanceControl Chase 40 6.0
call static:ForgePerformance.Crowd.PerformanceControl ChaseState --until ChaseState done --timeout 60
call static:ForgePerformance.Crowd.PerformanceControl ChaseState as=chase-path-2
wait 4s
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" false
call static:ForgePerformance.Crowd.PerformanceControl Mark "path-A-3"
teleport zone=0/MainLayer/7 area=1
call static:ForgePerformance.Crowd.PerformanceControl Chase 40 6.0
call static:ForgePerformance.Crowd.PerformanceControl ChaseState --until ChaseState done --timeout 60
call static:ForgePerformance.Crowd.PerformanceControl ChaseState as=chase-path-3
wait 4s
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" true
call static:ForgePerformance.Crowd.PerformanceControl Mark "path-B-4"
teleport zone=0/MainLayer/7 area=0
call static:ForgePerformance.Crowd.PerformanceControl Chase 40 6.0
call static:ForgePerformance.Crowd.PerformanceControl ChaseState --until ChaseState done --timeout 60
call static:ForgePerformance.Crowd.PerformanceControl ChaseState as=chase-path-4
wait 4s
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" false
call static:ForgePerformance.Crowd.PerformanceControl Mark "path-A-5"
teleport zone=0/MainLayer/7 area=1
call static:ForgePerformance.Crowd.PerformanceControl Chase 40 6.0
call static:ForgePerformance.Crowd.PerformanceControl ChaseState --until ChaseState done --timeout 60
call static:ForgePerformance.Crowd.PerformanceControl ChaseState as=chase-path-5
wait 4s
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" true
call static:ForgePerformance.Crowd.PerformanceControl Mark "path-B-6"
teleport zone=0/MainLayer/7 area=0
call static:ForgePerformance.Crowd.PerformanceControl Chase 40 6.0
call static:ForgePerformance.Crowd.PerformanceControl ChaseState --until ChaseState done --timeout 60
call static:ForgePerformance.Crowd.PerformanceControl ChaseState as=chase-path-6
wait 4s
call static:ForgePerformance.Crowd.PerformanceControl Set "PathfindingIterations" false
call static:ForgePerformance.Crowd.PerformanceControl Read as=final
clear enemies
call static:ForgePerformance.Crowd.PerformanceControl Mark "end"
wait 2s
