<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ForgeOrdnanceFrames.Tests</RootNamespace>
    <AssemblyName>ForgeOrdnanceFrames.Core.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Core sources are compiled straight into the test: they reference no game or Unity assembly. -->
    <Compile Include="../../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeCore/Once/Fnv.cs;../../../ForgeCore/Once/StrictJson.cs" Link="ForgeCore/%(Filename)%(Extension)" />
    <!-- ForgeCore's shared special slot the suit gun leases and its slow-frame timers (Core, no game or Unity assembly). -->
    <Compile Include="../../../ForgeCore/Core/SpecialSlot.cs;../../../ForgeCore/Core/NetEpoch.cs;../../../ForgeCore/Core/Log.cs;../../../ForgeCore/Once/OnceReporter.cs" Link="ForgeCore/%(Filename)%(Extension)" />
    <!-- ForgeUI Core the cockpit drives (no Unity types): the progress bar, the reveal, the power-on timeline and message. -->
    <Compile Include="../../../ForgeUI/Core/ProgressBar.cs;../../../ForgeUI/Core/HudReveal.cs;../../../ForgeUI/Core/Easing.cs;../../../ForgeUI/Core/PowerOnTimeline.cs;../../../ForgeUI/Core/BootMessage.cs;../../../ForgeUI/Core/HudLayout.cs;../../../ForgeUI/Core/GaugeMath.cs;../../../ForgeUI/Core/Meter.cs;../../../ForgeUI/Core/Bearing.cs;../../../ForgeUI/Core/ScopeSwitches.cs" Link="UIKit/%(Filename)%(Extension)" />
    <!-- ForgeVisual's body bones and pose rules the suits' rig maps onto (Core, no game or Unity assembly). -->
    <Compile Include="../../../ForgeVisual/Core/BodyRig.cs" Link="ForgeVisual/%(Filename)%(Extension)" />
<Compile Include="../../../ForgeCore/Core/EnemyAlert.cs" Link="ForgeCore/%(Filename)%(Extension)" />
    <Compile Include="Program.cs;NativeChecks.cs;NativeDoubles.cs;HudChecks.cs;R2Checks.cs;RocketChecks.cs;SoundChecks.cs;EffectsChecks.cs;BootChecks.cs;SceneChecks.cs;GunChecks.cs;GunLoanChecks.cs;CockpitChecks.cs;LangChecks.cs" />
    <!-- Exercise the real lifecycle and sender checks with offline game/network doubles. -->
    <Compile Include="../../Native/FrameWorld.cs;../../Native/FrameNetwork.cs;../../Native/FramesPayload.cs;../../Native/FrameAssets.cs;../../Native/Noise.cs" Link="Native/%(Filename)%(Extension)" />
    <None Include="../../Definitions/frames.json" Link="frames.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
