<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ForgeUI.Tests</RootNamespace>
    <AssemblyName>ForgeUI.Core.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Core sources are compiled straight into the test: they reference no game or Unity assembly. -->
    <Compile Include="../../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeCore/Core/EnemyAlert.cs" Link="Core/EnemyAlert.cs" />
    <ProjectReference Include="../../../ForgeCore/Once/ForgeCore.Once.csproj" />
    <Compile Include="Program.cs;MenuScreenChecks.cs;InputChecks.cs;InputDoubles.cs;UiChecks.cs;UiDoubles.cs;AuditChecks.cs;TemplateChecks.cs;LayoutChecks.cs;ScreenChecks.cs;TextChecks.cs;CapabilityChecks.cs;IconChecks.cs;ReadoutChecks.cs;CockpitChecks.cs;PowerOnChecks.cs;EnemyBarChecks.cs;PickerIconChecks.cs;LocationChecks.cs;CountdownChecks.cs;ChatChecks.cs;HeldMagazineChecks.cs;BootLayoutChecks.cs;KeyBindChecks.cs;CompassChecks.cs;WaypointChecks.cs;HitFeedbackChecks.cs;ConfirmChecks.cs;GearNameChecks.cs;PatchTargetChecks.cs;ScreenEffectChecks.cs;GearIconChecks.cs;GearIconDoubles.cs;SliderChecks.cs;TimelineChecks.cs" />
    <Compile Include="../../Native/Input.cs;../../Native/LobbyButtons.cs;../../Native/MenuBar.cs;../../Native/MenuScreen.cs;../../Native/UIKit.cs;../../Native/Picker.cs;../../Native/PickerSource.cs;../../Native/Hud.cs;../../Native/MenuCanvas.cs;../../Native/MenuTooltip.cs;../../Native/PickerSkin.cs;../../Native/GearIcons.cs;../../Native/IconJobLoad.cs" Link="Native/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

