<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ForgePlayer.PlayerNativeEvidence.Tests</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="ValidateEvidenceReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GTFOBepInExPath)/core/Mono.Cecil.dll')"
      Text="Set GTFOBepInExPath to existing BepInEx metadata references." />
  </Target>
  <ItemGroup>
    <Reference Include="Mono.Cecil" HintPath="$(GTFOBepInExPath)/core/Mono.Cecil.dll" />
    <ProjectReference Include="../../../../ForgeCore/Once/ForgeCore.Once.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup><Compile Include="../PlayerNativeLayout/*.cs;../../../tools/RegenerateHookEvidence/Player/EvidenceRegenerator.cs;../../../tools/RegenerateHookEvidence/HookRows.cs;../../../../Testing/SourceTools/DomainTypes.cs" /></ItemGroup>
</Project>